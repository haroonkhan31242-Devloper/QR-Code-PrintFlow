# Copy this file to .env and fill in the values.

# Port the server listens on.
PORT=3000

# First Super Admin account. Only used when no Super Admin exists yet (first start).
# The password is temporary: the Super Admin must change it at first sign-in.
# In production the server refuses to start without these on first launch.
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=change-me-123

# Where the database and uploaded files are kept (default: ./data).
# DATA_DIR=data

# How long a sign-in lasts, in hours (default 12).
# SESSION_TTL_HOURS=12

# Set when running behind a reverse proxy (e.g. "1"), so rate limits see the real client IP.
# TRUST_PROXY=1
